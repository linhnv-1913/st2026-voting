{
  "entities": {
    "Config": {
      "title": "Config",
      "description": "App configuration",
      "type": "object",
      "properties": {
        "question": { "type": "string", "maxLength": 200 },
        "options": { "type": "array" },
        "isActive": { "type": "boolean" },
        "startTime": { "type": ["integer", "null"] },
        "durationMinutes": { "type": ["integer", "null"] },
        "endTime": { "type": ["integer", "null"] }
      },
      "required": ["question", "options", "isActive"]
    },
    "Vote": {
      "title": "Vote",
      "description": "User vote",
      "type": "object",
      "properties": {
        "accessCode": { "type": "string", "maxLength": 12 },
        "optionIds": { "type": "array", "minItems": 3, "maxItems": 3 },
        "userId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "integer" }
      },
      "required": ["accessCode", "optionIds", "userId", "timestamp"]
    },
    "VoteAccessLink": {
      "title": "Vote access link",
      "description": "Bearer link with an atomic vote quota",
      "type": "object",
      "properties": {
        "voteCount": { "type": "integer", "minimum": 0, "maximum": 10 },
        "maxVotes": { "type": "integer", "const": 10 },
        "isActive": { "type": "boolean" }
      },
      "required": ["voteCount", "maxVotes", "isActive"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "config/{configId}": {
      "schema": { "$ref": "#/entities/Config" },
      "description": "Global configuration"
    },
    "votes/{voteId}": {
      "schema": { "$ref": "#/entities/Vote" },
      "description": "User votes"
    },
    "vote-links/{accessCode}": {
      "schema": { "$ref": "#/entities/VoteAccessLink" },
      "description": "One of the 16 vote access links and its 10-vote quota"
    },
    "admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin users"
    }
  }
}
