rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Config Rules
    function isValidConfig(data) {
      return data.keys().hasAll(['question', 'options', 'isActive']) &&
             data.question is string && data.question.size() <= 200 &&
             data.options is list && data.options.size() <= 4 &&
             data.isActive is bool;
    }

    match /config/{configId} {
      allow read: if true; // Anyone can read config
      allow create: if isAdmin() && isValidId(configId) && isValidConfig(incoming());
      allow update: if isAdmin() && isValidConfig(incoming());
      allow delete: if isAdmin();
    }

    // Vote Rules
    function isValidVote(data) {
      let hasOptionId = data.keys().hasAny(['optionId']) && data.optionId is string && data.optionId.size() <= 50;
      let hasOptionIds = data.keys().hasAny(['optionIds']) && data.optionIds is list && data.optionIds.size() <= 4;
      return (hasOptionId || hasOptionIds) &&
             data.keys().hasAll(['userId', 'timestamp']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.timestamp is number;
    }

    match /votes/{voteId} {
      allow get: if true;
      allow list: if isAdmin();
      // Anyone can vote. We enforce they own their vote via userId in document id.
      allow create: if isValidId(voteId) && isValidVote(incoming()) && voteId == 'vote_' + incoming().userId;
      allow update: if isValidVote(incoming()) && incoming().userId == existing().userId;
      allow delete: if isAdmin();
    }

    // Admins Rules
    match /admins/{adminId} {
      allow read: if isAdmin() || request.auth.uid == adminId;
      // Bootstrapping: allow creation if no admins exist OR if already admin
      allow create: if isSignedIn() && isValidId(adminId) && 
                    (isAdmin() || request.auth.token.email == "nguyen.van.linh-c@sun-asterisk.com" || request.auth.token.email == "admin@matsuri.com");
      allow update, delete: if isAdmin();
    }
  }
}
