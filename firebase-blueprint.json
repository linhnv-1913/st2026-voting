{
  "entities": {
    "Config": {
      "title": "Config",
      "description": "App configuration",
      "type": "object",
      "properties": {
        "question": { "type": "string", "maxLength": 200 },
        "options": { "type": "array" },
        "isActive": { "type": "boolean" },
        "endTime": { "type": "integer" }
      },
      "required": ["question", "options", "isActive"]
    },
    "Vote": {
      "title": "Vote",
      "description": "User vote",
      "type": "object",
      "properties": {
        "optionId": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "integer" }
      },
      "required": ["optionId", "userId", "timestamp"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "config/{configId}": {
      "schema": { "$ref": "#/entities/Config" },
      "description": "Global configuration"
    },
    "votes/{voteId}": {
      "schema": { "$ref": "#/entities/Vote" },
      "description": "User votes"
    },
    "admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin users"
    }
  }
}
